<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="una.eif206.avi.controllers.LoginViewController"
      alignment="CENTER"
      spacing="12"
      prefHeight="640.0" prefWidth="480.0">
    <padding>
        <Insets top="40.0" right="40.0" bottom="40.0" left="40.0" />
    </padding>
    <children>
        <Label text="Iniciar sesión" style="-fx-font-size: 22px; -fx-font-weight: bold;" />
        <Label text="Seleccione la fuente de datos con la que desea validar sus credenciales."
               wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #555555;" />
        <TextField fx:id="campoUsuario" promptText="Usuario" />
        <PasswordField fx:id="campoContrasena" promptText="Contraseña" />
        <ComboBox fx:id="comboFuenteDatos" promptText="Fuente de datos" maxWidth="Infinity" />
        <Label fx:id="etiquetaError" wrapText="true"
               style="-fx-text-fill: #b91c1c; -fx-font-size: 12px;" />
        <Button fx:id="botonIngresar" mnemonicParsing="false" text="Iniciar sesión" />
        <Button fx:id="botonCancelar" mnemonicParsing="false" text="Cancelar" />
    </children>
</VBox>
