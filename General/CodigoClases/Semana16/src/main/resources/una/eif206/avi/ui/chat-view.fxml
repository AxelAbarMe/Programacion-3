<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="una.eif206.avi.controllers.ChatViewController"
        prefHeight="640.0"
        prefWidth="620.0">

   <padding>
      <Insets
              top="12.0"
              right="12.0"
              bottom="12.0"
              left="12.0"/>
   </padding>


   <top>

      <VBox spacing="5.0">

         <HBox spacing="8.0">

            <Button
                    fx:id="botonVolverChat"
                    text="←"/>

            <Label
                    fx:id="etiquetaTituloChat"
                    text="Nueva conversación"
                    style="-fx-font-size: 16px;
                               -fx-font-weight: bold;"/>

         </HBox>


         <Label
                 fx:id="etiquetaAvisoSesion"
                 wrapText="true"
                 style="-fx-text-fill: #b45309;
                           -fx-font-size: 11px;"/>

      </VBox>

   </top>


   <center>

      <VBox spacing="8.0">

         <padding>
            <Insets top="10.0"/>
         </padding>

         <Label
                 text="Conversación"
                 style="-fx-font-weight: bold;"/>

         <TextArea
                 fx:id="areaHistorial"
                 editable="false"
                 wrapText="true"
                 VBox.vgrow="ALWAYS"/>

      </VBox>

   </center>


   <bottom>

      <VBox spacing="7.0">

         <padding>
            <Insets top="10.0"/>
         </padding>


         <Label
                 fx:id="etiquetaEstadoExperto"
                 text=""
                 wrapText="true"
                 style="-fx-text-fill: #555555;
                           -fx-font-size: 11px;"/>


         <HBox spacing="8.0">

            <TextField
                    fx:id="campoTexto"
                    promptText="Escriba su mensaje..."
                    HBox.hgrow="ALWAYS"/>


            <Button
                    fx:id="botonEnviar"
                    text="Enviar"/>


            <Button
                    fx:id="botonConsultarExperto"
                    text="Consultar experto"
                    disable="true"/>

         </HBox>

      </VBox>

   </bottom>

</BorderPane>